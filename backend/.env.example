# Backend Environment Variables
PROJECT_NAME="ArthDrishti Risk Intelligence"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="arthdrishti"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/arthdrishti"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & JWT
JWT_SECRET_KEY="generate_and_replace_with_a_secure_random_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Seed
FIRST_SUPERUSER_EMAIL="admin@arthdrishti.local"
FIRST_SUPERUSER_PASSWORD="ChangeMeAdmin123!"

# Storage
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR="./uploads"

# ML & Monitoring
MLFLOW_TRACKING_URI="http://localhost:5000"
MODELS_DIR="./app/ml/models"

# Groq LLM Settings
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-20b"

# Email / SMTP
SMTP_ENABLED=false
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAILS_FROM_EMAIL="acode4269@gmail.com"
EMAILS_FROM_NAME="ArthDrishti Intelligence"

