# ==============================================================================
# ArthDrishti - AI Financial Risk Intelligence Platform
# Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` (for local development and Docker Compose).
# 2. Update placeholder values (especially secrets and database credentials).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="ArthDrishti Risk Intelligence"
ENVIRONMENT="development"               # development | staging | production
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Comma-separated list of allowed origins for CORS (include your Next.js frontend URL)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="arthdrishti"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"

# Full SQLAlchemy Database URL
# Sync (Alembic/default): postgresql://<user>:<password>@<server>:<port>/<db>
# Async (asyncpg):        postgresql+asyncpg://<user>:<password>@<server>:<port>/<db>
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/arthdrishti"

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 3. REDIS & CACHE
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 4. CELERY ASYNC WORKER (Task Queue)
# ------------------------------------------------------------------------------
# Broker: redis://localhost:6379/1
# Result Backend: redis://localhost:6379/2
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key: e.g. `openssl rand -hex 32`
JWT_SECRET_KEY="generate_and_replace_with_a_secure_random_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Superuser/Admin Seed Credentials (auto-created on first migration/seed)
FIRST_SUPERUSER_EMAIL="admin@arthdrishti.local"
FIRST_SUPERUSER_PASSWORD="ChangeMeAdmin123!"

# ------------------------------------------------------------------------------
# 6. FILE STORAGE (Bank Statements, Uploads & PDF Reports)
# ------------------------------------------------------------------------------
# Set to 'true' to store uploads locally on disk during dev; 'false' to use AWS S3 / MinIO
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR="./uploads"

# AWS S3 / MinIO Configuration (Required if USE_LOCAL_STORAGE=false)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="arthdrishti-documents"
# Optional custom S3 endpoint URL (for MinIO or LocalStack, e.g. http://localhost:9000)
# AWS_S3_ENDPOINT_URL="http://localhost:9000"

# ------------------------------------------------------------------------------
# 7. EMAIL / SMTP (Email Verification, Password Reset, Alerts)
# ------------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAILS_FROM_EMAIL="acode4269@gmail.com"
EMAILS_FROM_NAME="ArthDrishti Intelligence"

# ------------------------------------------------------------------------------
# 8. MLOps, MODEL REGISTRY & DRIFT MONITORING
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="arthdrishti-risk-intelligence"
MODELS_DIR="./app/ml/models"
EVIDENTLY_WORKSPACE_PATH="./mlops/evidently_workspace"

# ------------------------------------------------------------------------------
# 9. AI ADVISOR / LLM (Groq API Service)
# ------------------------------------------------------------------------------
# Groq API configuration using gpt-oss-20b open-weight model:
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-20b"

# ------------------------------------------------------------------------------
# 10. FRONTEND (Next.js) - Client-accessible variables prefixed with NEXT_PUBLIC_
# ------------------------------------------------------------------------------
# FastAPI Backend REST Base URL
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# Frontend Application Origin
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Toggle mock data fallback while backend endpoints are under construction
# (set to true to test UI with mock fixtures, false when pointing to live backend)
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# ------------------------------------------------------------------------------
# 11. MONITORING & METRICS (Docker / Prometheus / Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_METRICS_PATH="/metrics"
GRAFANA_ADMIN_PASSWORD="admin_grafana_password"
